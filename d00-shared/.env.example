# d00-shared/.env.example
# =============================================================================
# 이 파일을 d00-shared/.env 로 복사한 뒤 값을 채우면 local_llm.py가 자동으로
# 읽는다(python-dotenv). d00-shared/.env 는 .gitignore 대상이므로 커밋되지
# 않는다 — 매번 커맨드라인에 OLLAMA_MODEL=... 을 붙이는 대신 여기 고정해두는
# 용도.
#
#   cp d00-shared/.env.example d00-shared/.env
#
# 셸 환경변수가 있으면 이 파일보다 우선한다.
# =============================================================================

# Ollama 데몬 주소 (기본값: http://localhost:11434)
# OLLAMA_HOST=http://localhost:11434

# 기본 모델 (기본값: exaone3.5:2.4b)
# OLLAMA_MODEL=qwen2.5-1.5b-vulnerable-fixed
